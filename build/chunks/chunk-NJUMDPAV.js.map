  "clip_points_to_area": {
   "version": "0.4.0",
   "released": "2026-11-24",
   "changes": [
    {
     "kind": "added",
     "description": "The mask may be a polygon layer as well as a study area. Both ports are always offered and neither is required on its own; the run refuses two masks, because a point inside one and outside the other has no single answer. A point kept by a layer records WHICH polygon held it, since a layer is many masks and “inside the buffer” loses which one. Built because a buffer around 656 km of border spans 3.59°, which the one-degree scope limit rightly refuses to call a study area, leaving the buffer as a polygon layer that nothing could clip by."
    }
   ],
   "breaking": false,
